# Dockerfile for Chromium TWCC Peer with Playwright
FROM node:20-slim

# Install dependencies for Playwright Chromium, network tools, and ffmpeg
RUN apt-get update && \
    apt-get install -y \
    iproute2 \
    iputils-ping \
    curl \
    wget \
    ffmpeg \
    python3 \
    && apt-get clean && \
    rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Copy package files first
COPY package.json /app/

# Install Node dependencies and Playwright browsers
RUN npm install && \
    npx playwright install --with-deps chromium

# Copy pre-generated test video (generated by bwe_test_framework.sh using generate_test_video.sh)
# This avoids installing ffmpeg in Docker just for one-time generation
COPY test_video.webm /app/test_video.webm
RUN echo "Test video: $(du -h /app/test_video.webm)"

# Copy peer script, HTML page, and entrypoint
COPY peer.js /app/
COPY index.html /app/
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /app/peer.js /entrypoint.sh

# Default server URL
ENV SERVER_URL="http://host.docker.internal:8080"

ENTRYPOINT ["/entrypoint.sh"]
